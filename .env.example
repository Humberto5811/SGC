# Configuración del backend SGC
PORT=3000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sgc_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MAX=20

# CORS — orígenes permitidos (separados por coma)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5177,http://localhost:5178,http://localhost:3000

# Workflow Engine SGC — feature flags (fase base)
# Lectura/simulación siempre activas si WORKFLOW_ENGINE_BASE=true.
# WORKFLOW_ENGINE_WRITE_ENABLED debe permanecer false hasta migrar rutas productivas.
WORKFLOW_ENGINE_BASE=true
WORKFLOW_ENGINE_WRITE_ENABLED=false
WORKFLOW_ENGINE_INVITACIONES=false
WORKFLOW_ENGINE_VALIDACIONES=false
WORKFLOW_ENGINE_CUADRO=false
WORKFLOW_ENGINE_REGISTRO=false
WORKFLOW_ENGINE_ORDENES=false
WORKFLOW_ENGINE_VIATICOS=false
